# Bublo - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env é ignorado pelo Git (não versionar credenciais).

# Banco de dados
DB_NAME=bublo
DB_USERNAME=bublo
DB_PASSWORD=bublo
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/bublo

# Aplicação
SERVER_PORT=8080

# Credenciais iniciais do administrador (obrigatórias; o app não sobe sem elas).
# Usuário e senha "admin" servem só para desenvolvimento: troque em qualquer ambiente público.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Carregar dados de demonstração na primeira inicialização
DEMO_DATA_ENABLED=true
